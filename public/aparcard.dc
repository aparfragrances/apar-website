<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="assets/js/dc-runtime.js"></script>
</head>
<body>
<x-dc>
<div style="position:relative;display:flex;flex-direction:column;gap:14px;height:100%;font-family:Barlow,system-ui,sans-serif">
<a href="{{ p.href }}" style="position:relative;display:block;aspect-ratio:4/5;border-radius:8px;overflow:hidden;background:#e9dfcb">
<img src="{{ p.img }}" alt="{{ p.name }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:{{ p.pos }};display:block;transition:transform 1.1s cubic-bezier(.2,.6,.2,1)" style-hover="transform:scale(1.06)">
<sc-if value="{{ p.hasOff }}" hint-placeholder-val="{{ false }}"><span style="position:absolute;top:12px;left:12px;background:#6d1a2a;color:#f7f2e8;font-size:11px;letter-spacing:.08em;padding:5px 10px;border-radius:40px">{{ p.off }}</span></sc-if>
<sc-if value="{{ p.isOut }}" hint-placeholder-val="{{ false }}"><span style="position:absolute;bottom:12px;left:12px;background:rgba(247,242,232,.94);color:#6d1a2a;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:6px 10px;border-radius:40px">Out of stock</span></sc-if>
</a>
<button onClick="{{ p.wish }}" aria-label="Add to wishlist" style="position:absolute;top:10px;right:10px;width:40px;height:40px;border-radius:50%;border:0;background:rgba(247,242,232,.94);cursor:pointer;display:grid;place-items:center"><svg width="18" height="18" viewBox="0 0 24 24" fill="{{ p.wishFill }}" stroke="{{ p.wishStroke }}" stroke-width="1.6"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"></path></svg></button>
<div style="display:flex;flex-direction:column;gap:6px;flex:1">
<div style="font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#8a6d3b">{{ p.cat }}</div>
<a href="{{ p.href }}" style="font-family:'Bodoni Moda',serif;font-size:22px;line-height:1.15;color:#0f3b2e">{{ p.name }}</a>
<div style="font-size:13px;color:#6b6552">{{ p.size }} · {{ p.rating }}</div>
<div style="display:flex;align-items:baseline;gap:8px;margin-top:2px"><span style="font-size:18px;font-weight:600;color:#1c2420">{{ p.from }}{{ p.price }}</span><sc-if value="{{ p.hasOff }}" hint-placeholder-val="{{ false }}"><span style="font-size:14px;color:#8b857a;text-decoration:line-through">{{ p.mrp }}</span></sc-if></div>
</div>
<button onClick="{{ p.add }}" style="padding:13px 16px;border:1px solid #0f3b2e;background:transparent;color:#0f3b2e;font:inherit;font-size:12px;letter-spacing:.16em;text-transform:uppercase;border-radius:40px;cursor:pointer" style-hover="background:#0f3b2e;color:#f7f2e8">{{ p.addLabel }}</button>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:300,&quot;height&quot;:560},&quot;p&quot;:{&quot;editor&quot;:null,&quot;tsType&quot;:&quot;object&quot;}}"></script>
</body>
</html>
